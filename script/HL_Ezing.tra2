--param:AssignmentID,0
--param:Nonce,0
--information:HL_Ezing curve evaluator by halkun19

local ASSIGNMENT_OFFSET = 1000000000

local gp = obj.getpoint
local raw_id, nonce = gp("param")

local idx, t = math.modf(gp("index"))
local num = gp("num")
if num and num > 1 then
    if idx < 0 then
        idx, t = 0, 0
    elseif idx >= num - 1 then
        idx, t = num - 2, 1
    end
end

local curve_id = raw_id
if raw_id and raw_id >= ASSIGNMENT_OFFSET then
    local module = obj.module("HL_Ezing.aux2") or obj.module("HL_Ezing")
    if module and module.getsegment then
        local id = module.getsegment(raw_id - ASSIGNMENT_OFFSET, idx)
        if id and id > 0 then
            curve_id = id
        else
            curve_id = 0
        end
    else
        curve_id = 0
    end
end

if curve_id == nil then
    return gp("default")
end

local st = gp(idx)
local ed = gp(idx + 1)
local module = obj.module("HL_Ezing.aux2") or obj.module("HL_Ezing")
if not module or not module.getcurve then
    return st + (ed - st) * t
end
local v = module.getcurve(curve_id, nonce or 0, t)
if v == nil then
    return st + (ed - st) * t
end
return st + (ed - st) * v
